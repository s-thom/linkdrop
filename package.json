  "sideEffects": false,
  "scripts": {
    "build": "astro build",
    "build:preview": "cross-env NODE_ENV=development astro build",
    "dev": "astro dev",
    "preview": "cross-env NODE_ENV=development astro preview --config ./astro.config.preview.mjs",
    "docker": "docker compose up -d",
    "format": "prettier --write . \"!**/postgres-data\" && prettier --plugin \"prettier-plugin-astro\" --write \"**/*.astro\" \"!**/postgres-data\"",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start": "cross-env NODE_ENV=production node ./dist/server/entry.mjs",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "prettier": {},
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/postgres-data"
  ],
  "dependencies": {
