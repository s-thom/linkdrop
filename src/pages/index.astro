---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Demo from "~/components/Demo";
import Header from "~/components/Header/index.astro";
import { getUserId } from "~/lib/session";
import { ALLOW_EMAIL_JOIN } from "astro:env/server";

const userId = await getUserId(Astro.request);
const allowSignUp = ALLOW_EMAIL_JOIN;
---

<BaseLayout title="linkdrop">
  <div class="public-page home">
    <div class:list={["intro", { "logged-out": !userId }]}>
      <Header
        size="large"
        mode={userId ? "user" : "public"}
        allowSignUp={allowSignUp}
      />
      <main>
        <p class="lead">
          An application to drop interesting links from around the internet.
          <br />a small project by{" "}
          <a
            href="https://sthom.kiwi"
            target="_blank"
            rel="noreferrer nofollow"
            class="nav-link"
          >
            Stuart Thomson
          </a>
          .{" "}
          <a
            href="https://github.com/s-thom/linkdrop"
            target="_blank"
            rel="noreferrer nofollow"
            class="nav-link"
          >
            (Source code)
          </a>
        </p>
      </main>
    </div>

    {!userId && (
      <aside>
        <hr />
        <p class="demo-intro">
          {allowSignUp
            ? "Before signing up, you can get the idea with a little demo"
            : "Signing up is currently disabled, but you can get the idea with a little demo"}
        </p>
        <Demo client:load />
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .home {
    padding-inline: var(--space-2);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
  }

  .intro.logged-out {
    min-height: 85vh;
  }

  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 80rem;
    margin-inline: auto;
  }

  aside {
    display: inline-block;
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
  }

  hr {
    margin-block: var(--space-4);
  }

  .demo-intro {
    text-align: center;
    text-transform: lowercase;
  }

  @media (min-width: 640px) {
    main {
      padding-inline: var(--space-6);
    }

    aside {
      max-width: 56rem;
    }
  }

  @media (min-width: 1024px) {
    main {
      padding-inline: var(--space-8);
    }
  }
</style>
