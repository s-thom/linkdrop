---
import AuthLayout from "~/layouts/AuthLayout.astro";
import AdminSidebar from "~/components/AdminSidebar.astro";
import LinkDropText from "~/components/LinkDropText.astro";
import { getUserById } from "~/lib/models/user.server";

const userId = Astro.locals.userId!;
const user = await getUserById(userId);

if (!user || !user.isAdmin) {
  return new Response("Not Found", { status: 404 });
}
---

<AuthLayout title="Admin">
  <div class="page-layout">
    <AdminSidebar />
    <main class="page-main">
      <h2 class="hero-title">
        <LinkDropText link="ad" drop="min" />
      </h2>
    </main>
  </div>
</AuthLayout>
