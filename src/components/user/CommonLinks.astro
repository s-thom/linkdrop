---
import type { getUserMostClickedLinks } from "~/lib/models/linkanalytics.server";

export interface Props {
  commonLinks: Awaited<ReturnType<typeof getUserMostClickedLinks>>;
}

const { commonLinks } = Astro.props;
---

<section class="card">
  <h3 class="section-title">Most commonly clicked links</h3>
  <p>These are the links you keep coming back to:</p>
  <ul class="tag-list">
    {commonLinks.map(({ link, clicks }) => (
      <li>
        <a
          href={link.url}
          target="_blank"
          rel="noreferrer nofollow"
          class="text-link common-link-link"
          data-umami-event="common-link"
          data-link-id={link.id}
        >
          {link.url}
        </a>
        {` (${clicks})`}
      </li>
    ))}
  </ul>
</section>

<style>
  li {
    list-style: disc inside;
  }

  .common-link-link {
    margin-bottom: var(--space-2);
    word-break: break-all;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLAnchorElement>("a.common-link-link")
      .forEach((link) => {
        link.addEventListener("click", () => {
          const linkId = link.dataset.linkId;
          if (!linkId) {
            return;
          }

          const formData = new FormData();
          formData.append("type", "click");
          navigator.sendBeacon(`/links/${linkId}/on`, formData);
        });
      });
  });
</script>
