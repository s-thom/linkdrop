---
export interface Props {
  isAdmin?: boolean;
}
const { isAdmin = false } = Astro.props;
---

<aside class="sidebar" transition:name="user-sidebar">
  <h3 class="section-title">User</h3>
  <nav>
    <ul>
      <li>
        <a href="/user" class="nav-link">
          Profile & Settings
        </a>
      </li>
      <li>
        <a href="/user/account" class="nav-link">
          Account & Security
        </a>
      </li>
      <li>
        <a href="/user/tags" class="nav-link">
          Tags
        </a>
      </li>
      <li>
        <a href="/user/stats" class="nav-link">
          Stats
        </a>
      </li>
      <li>
        <a href="/user/help" class="nav-link">
          Help
        </a>
      </li>
      <li>
        <a href="/user/extras" class="nav-link">
          Extras
        </a>
      </li>
      {isAdmin && (
        <li>
          <a href="/admin" class="nav-link">
            Admin
          </a>
        </li>
      )}
    </ul>
    <form action="/logout" method="post" class="logout">
      <button type="submit" class="button">
        Log out
      </button>
    </form>
  </nav>
</aside>

<style>
  .logout {
    display: inline-block;
    margin-top: var(--space-6);
  }
</style>
