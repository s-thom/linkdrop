---
export interface Props {
  link?: string;
  drop?: string;
}

const { link = "link", drop = "drop" } = Astro.props;
---

<span class="link-drop">
  <span>{link}</span>
  <span class="drop">{drop}</span>
</span>

<style>
  .link-drop {
    font-style: italic;
  }

  .drop {
    display: inline-block;
    translate: 0 0.06em;
    rotate: 5deg;
  }
</style>
