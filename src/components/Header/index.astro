---
import LinkDropText from "~/components/LinkDropText.astro";
import PublicNav from "./PublicNav.astro";
import UserNav from "./UserNav.astro";

export interface Props {
  text?: { link: string; drop: string };
  size: "large" | "small";
  mode: "user" | "public" | "none";
  allowSignUp?: boolean;
  transitionName?: string;
}

const {
  size,
  mode,
  allowSignUp = false,
  text = { link: "link", drop: "drop" },
  transitionName,
} = Astro.props;
---

<header
  class:list={["site-header", size]}
  transition:name={transitionName ?? "header__default"}
>
  <h1 class:list={["logo", { "hero-title": size === "large" }]}>
    <a href="/">
      <LinkDropText link={text.link} drop={text.drop} />
    </a>
  </h1>
  {mode !== "none" && (
    <nav>
      {mode === "public" && <PublicNav allowSignUp={allowSignUp} />}
      {mode === "user" && <UserNav />}
    </nav>
  )}
</header>

<style>
  .site-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2);
  }

  .site-header.small {
    border-bottom: 1px solid var(--color-card-border);
  }

  .logo {
    white-space: nowrap;
    text-align: center;
    letter-spacing: -0.025em;
  }

  .small .logo {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }

  nav {
    display: flex;
    gap: var(--space-2);
    text-transform: lowercase;
  }
</style>
